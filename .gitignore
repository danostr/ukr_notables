# ==========================================
# GIT IGNORE FILE
# Tells Git which files and folders to exclude from the public repository
# ==========================================

# Ignore the backend data processing pipeline (scripts and raw data)
# We only want the final map_data_with_topics.json in the repo
/data_pipeline/
/data_pipeline/map_lite.json
/data_pipeline/people_details.json
/data/

# Ignore standard Python cache directories to keep the repo clean
__pycache__/

# Ignore local debugging logs and personal scratchpad notes
.ideas.txt